# Template author: Tinted Theming (https://github.com/tinted-theming)

_gen_fzf_default_opts() {

local color00='#000000'
local color01='#0e0e0e'
local color02='#181818'
local color03='#333333'
local color04='#707070'
local color05='#cccccc'
local color06='#d6d6d6'
local color07='#ffffff'
local color08='#999999'
local color09='#bbbbbb'
local color0A='#dddddd'
local color0B='#bbbbbb'
local color0C='#cccccc'
local color0D='#888888'
local color0E='#aaaaaa'
local color0F='#7a7a7a'

export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS"\
" --color=bg+:$color01,bg:$color00,spinner:$color0C,hl:$color0D"\
" --color=fg:$color04,header:$color0D,info:$color0A,pointer:$color0C"\
" --color=marker:$color0C,fg+:$color06,prompt:$color0A,hl+:$color0D"

}

_gen_fzf_default_opts
